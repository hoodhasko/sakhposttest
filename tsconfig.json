{
  "extends": "@react-native/typescript-config",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"],
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "@screens/*": ["./screens/*"],
      "@config/*": ["./config/*"],
      "@assets/*": ["./assets/*"],
      "@components/*": ["./components/*"],
      "@app/*": ["./app/*"],
      "@models/*": ["./models/*"]
    }
  }
}
